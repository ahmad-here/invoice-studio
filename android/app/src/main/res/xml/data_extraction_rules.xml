<?xml version="1.0" encoding="utf-8"?>
<!-- Invoices and client details stay on the device: no cloud backup.
     Device-to-device transfer (new phone setup) is still allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
